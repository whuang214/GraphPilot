  "diagramName": "kitepay-domain-structure",
  "diagramType": "bdd_diagram",
  "authority": "as_implemented",
  "requests": [
    "The structure of what this system stores, and how those things relate."
  ],
  "evidence": [
    {
      "id": "ev-user",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 22,
          "start": 5
        },
        "path": "accounts/models.py",
        "symbol": "User"
      },
      "summary": "User extends AbstractUser with a unique handle, display_name, unique email, avatar_colour and joined_from_invite."
    },
    {
      "id": "ev-follow",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 33,
          "start": 25
        },
        "path": "accounts/models.py",
        "symbol": "Follow"
      },
      "summary": "Follow joins a follower User to a followed User, unique together, and decides who sees FRIENDS-visibility payments."
    },
    {
      "id": "ev-wallet",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 17,
          "start": 5
        },
        "path": "wallets/models.py",
        "symbol": "Wallet"
      },
      "summary": "Wallet is one-to-one with User, carries a currency and created_at, and deliberately has no balance column."
    },
    {
      "id": "ev-account",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 22,
          "start": 4
        },
        "path": "ledger/models.py",
        "symbol": "Account"
      },
      "summary": "Account is a postable place, kind USER or HOUSE, optionally one-to-one with a Wallet; the house account has none."
    },
    {
      "id": "ev-entry",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 56,
          "start": 25
        },
        "path": "ledger/models.py",
        "symbol": "LedgerEntry"
      },
      "summary": "LedgerEntry is one side of a movement on an Account, created in balanced pairs and never edited, optionally linked to the Payment, Deposit or Withdrawal that caused it."
    },
    {
      "id": "ev-payment",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 28,
          "start": 6
        },
        "path": "payments/models.py",
        "symbol": "Payment"
      },
      "summary": "Payment records sender, recipient, amount_minor, note, a PUBLIC/FRIENDS/PRIVATE visibility and an idempotency_key."
    },
    {
      "id": "ev-request",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 55,
          "start": 31
        },
        "path": "payments/models.py",
        "symbol": "PaymentRequest"
      },
      "summary": "PaymentRequest records requester, payer, amount, note, status and expires_at, and points at the Payment that settled it via SET_NULL."
    },
    {
      "id": "ev-linked",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 17,
          "start": 5
        },
        "path": "rails/models.py",
        "symbol": "LinkedAccount"
      },
      "summary": "LinkedAccount is a user's CARD or BANK funding instrument with a label and masked_number."
    },
    {
      "id": "ev-deposit",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 32,
          "start": 20
        },
        "path": "rails/models.py",
        "symbol": "Deposit"
      },
      "summary": "Deposit is money entering the platform for a user from a LinkedAccount source (SET_NULL), with a status and a settles_on date."
    },
    {
      "id": "ev-withdrawal",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 49,
          "start": 35
        },
        "path": "rails/models.py",
        "symbol": "Withdrawal"
      },
      "summary": "Withdrawal is money leaving the platform for a user to a LinkedAccount destination (SET_NULL), with a status and a settles_on date."
    },
    {
      "id": "ev-feeditem",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 11,
          "start": 5
        },
        "path": "feed/models.py",
        "symbol": "FeedItem"
      },
      "summary": "FeedItem is one-to-one with a Payment and names the acting User, newest first."
    },
    {
      "id": "ev-notification",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 15,
          "start": 5
        },
        "path": "notifications/models.py",
        "symbol": "Notification"
      },
      "summary": "Notification stores per-user text, a link and a read flag, newest first."
    },
    {
      "id": "ev-balance",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 19,
          "start": 8
        },
        "path": "wallets/utils.py",
        "symbol": "available_balance"
      },
      "summary": "available_balance sums settled LedgerEntry rows for the wallet's account rather than reading a stored column."
    }
