          },
          "path": "circulation/tests.py",
          "symbol": "test_deleting_a_book_takes_its_copies"
        },
        "summary": "Deleting a Book deletes its BookCopy rows, so the book owns the lifecycle of its copies."
      },
      {
        "contentDigest": "sha256:6b329ec9030d48922f8e62b2b9cb7f60677b1874936926568bd7addbc5855bda",
        "id": "ev-protect-test",
        "kind": "test",
        "locator": {
