          "end": 27,
          "start": 24
        },
        "path": "backend/app/models.py",
        "symbol": "Status"
      },
      "summary": "The three task states: todo, doing, done."
    },
    {
      "id": "ev-project",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 87,
          "start": 76
        },
        "path": "backend/app/models.py",
        "symbol": "Project"
      },
      "summary": "Project belongs to a workspace, carries a name, colour and archived flag, and owns its tasks with cascade all, delete-orphan."
    },
    {
      "id": "ev-label",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 96,
          "start": 90
        },
        "path": "backend/app/models.py",
        "symbol": "Label"
      },
      "summary": "Label has a name and colour and a workspace_id foreign key that cascades on delete; no ORM back-reference names the collection."
    },
    {
      "id": "ev-task",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 119,
          "start": 99
        },
        "path": "backend/app/models.py",
        "symbol": "Task"
      },
      "summary": "Task belongs to a project, holds title, detail, status, position, optional assignee, due_on and completed_at, and owns subtasks and comments."
    },
    {
      "id": "ev-subtask",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 131,
          "start": 122
        },
        "path": "backend/app/models.py",
        "symbol": "Subtask"
      },
      "summary": "Subtask belongs to one task and carries a title, a done flag and a position."
    },
    {
      "id": "ev-comment",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 144,
          "start": 134
        },
        "path": "backend/app/models.py",
        "symbol": "Comment"
      },
      "summary": "Comment belongs to one task, has a body and created_at, and an author that is set to NULL when the user is deleted."
    },
    {
      "id": "ev-activity",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 155,
          "start": 147
        },
        "path": "backend/app/models.py",
        "symbol": "ActivityEvent"
      },
      "summary": "ActivityEvent records a verb and detail against a task at a time, with an actor that is set to NULL when the user is deleted."
    },
    {
      "id": "ev-task-labels",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 35,
          "start": 30
        },
        "path": "backend/app/models.py",
        "symbol": "task_labels"
      },
      "summary": "task_labels is the many-to-many join table between tasks and labels, keyed on both ids."
    },
    {
      "id": "ev-rollup",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 174,
          "start": 158
        },
        "path": "backend/app/models.py",
        "symbol": "_roll_up"
      },
      "summary": "An after_update listener on Subtask: when the last unfinished subtask is ticked, the task is set to DONE and completed_at is stamped."
    }
