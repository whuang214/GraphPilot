{
  "schemaVersion": "graphpilot.draft.v1",
  "kind": "diagramDraft",
  "diagramName": "kitepay-send-a-payment",
  "diagramType": "activity_diagram",
  "authority": "as_implemented",
  "requests": [
    "What happens when one person sends another a payment."
  ],
  "evidence": [
    {
      "id": "ev-view-pay",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 45,
          "start": 18
        },
        "path": "payments/views.py",
        "symbol": "pay"
      },
      "summary": "The /pay/ view: build PayForm, take or mint an idempotency key, short-circuit a replayed key, call send_payment, catch InsufficientFunds and ValueError onto the form, otherwise remember the key and redirect to the feed."
    },
    {
      "id": "ev-idem-module",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 28,
          "start": 15
        },
        "path": "core/idempotency.py",
        "symbol": "remember"
      },
      "summary": "mint, seen, remember and recall keep a 15-minute cache entry so a resubmitted form replays the first result instead of moving money again."
    },
    {
      "id": "ev-form",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 39,
          "start": 8
        },
        "path": "payments/forms.py",
        "symbol": "PayForm"
      },
      "summary": "PayForm resolves the @handle to a User, rejects paying yourself, parses the amount into minor units, and rejects an amount above the sender's available balance."
    },
    {
      "id": "ev-service",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 32,
          "start": 10
        },
        "path": "payments/services.py",
        "symbol": "send_payment"
      },
      "summary": "send_payment is atomic: it refuses a self-payment, refuses an amount above available balance, creates the Payment row, then posts the ledger pair."
    },
    {
      "id": "ev-post",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 41,
          "start": 26
        },
        "path": "ledger/services.py",
        "symbol": "post"
      },
      "summary": "post writes two LedgerEntry rows as a balanced pair, negative on the debit account and positive on the credit account, both linked to the causing payment."
    },
    {
      "id": "ev-balance",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 19,
          "start": 8
        },
        "path": "wallets/utils.py",
        "symbol": "available_balance"
      },
      "summary": "available_balance sums only settled ledger entries, so money from an uncleared deposit cannot be spent."
    },
    {
      "id": "ev-signals",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 24,
          "start": 9
        },
        "path": "payments/signals.py",
        "symbol": "notify_recipient"
      },
      "summary": "Two post_save receivers on Payment fire only on creation: one writes a Notification for the recipient, the other writes the FeedItem with the sender as actor."
    },
    {
      "id": "ev-accept",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 94,
          "start": 73
        },
        "path": "payments/views.py",
        "symbol": "accept_request"
      },
      "summary": "Paying a money request reaches the same send_payment service, as a PRIVATE payment, then marks the request accepted."
    },
    {
      "id": "ev-test-idem",
      "kind": "test",
      "locator": {
        "lineRange": {
          "end": 99,
          "start": 80
        },
        "path": "payments/test_journeys.py",
        "symbol": "test_submitting_the_same_payment_twice_only_sends_it_once"
      },
      "summary": "Posting the pay form twice with the same idempotency key leaves exactly one Payment and debits the sender once."
    },
    {
      "id": "ev-test-funds",
      "kind": "test",
      "locator": {
        "lineRange": {
          "end": 62,
          "start": 49
        },
        "path": "payments/test_journeys.py",
        "symbol": "test_money_that_has_not_cleared_cannot_be_spent"
      },
      "summary": "A payment funded by an uncleared deposit is rejected with 'more than your available balance' and creates no Payment."
    }
  ],
