{
  "schemaVersion": "graphpilot.draft.v1",
  "kind": "diagramDraft",
  "diagramName": "shelfmark-issue-a-copy",
  "diagramType": "activity_diagram",
  "authority": "as_implemented",
  "requests": [
    "What happens when a librarian issues a copy to a member."
  ],
  "evidence": [
    {
      "id": "ev-desk-form",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 7,
          "start": 3
        },
        "path": "templates/desk/desk.html",
        "symbol": "Check out"
      },
      "summary": "The desk page's Check out card posts the checkout form's membership number and barcode fields to the desk URL under an Issue button."
    },
    {
      "id": "ev-desk-url",
      "kind": "configuration",
      "locator": {
        "lineRange": {
          "end": 6,
          "start": 6
        },
        "path": "desk/urls.py",
        "symbol": "desk"
      },
      "summary": "The desk view is mounted at the root of /desk/ under the route name desk."
    },
    {
      "id": "ev-librarian-gate",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 10,
          "start": 10
        },
        "path": "desk/views.py",
        "symbol": "librarian_only"
      },
      "summary": "librarian_only is a user_passes_test that admits only an authenticated user whose is_librarian is true."
    },
    {
      "id": "ev-desk-entry",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 18,
          "start": 13
        },
        "path": "desk/views.py",
        "symbol": "desk"
      },
      "summary": "The desk view is wrapped in login_required and librarian_only, binds CheckoutForm with the out prefix, and only proceeds when the request is a POST carrying out-barcode and the form validates."
    },
    {
      "id": "ev-desk-outcome",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 30,
          "start": 18
        },
        "path": "desk/views.py",
        "symbol": "check_out"
      },
      "summary": "On a valid POST the view calls check_out, turns a NotAllowed into an error message, and on success reports the title, the member and the due date before redirecting back to the desk; anything that falls through re-renders the desk page."
    },
    {
      "id": "ev-form-clean",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 32,
          "start": 7
        },
        "path": "desk/forms.py",
        "symbol": "CheckoutForm"
      },
      "summary": "CheckoutForm resolves the membership number to a Member and the barcode to a BookCopy, erroring when either is unknown, and rejects the account outright if it has any open loan that is overdue."
    },
    {
      "id": "ev-checkout-service",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 22,
          "start": 13
        },
        "path": "circulation/services.py",
        "symbol": "check_out"
      },
      "summary": "check_out is a single atomic transaction: it refuses when can_borrow says no, refuses when the copy is not on the shelf, and otherwise creates the Loan with a due date from due_date_for."
    },
    {
      "id": "ev-can-borrow",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 26,
          "start": 19
        },
        "path": "circulation/eligibility.py",
        "symbol": "can_borrow"
      },
      "summary": "can_borrow refuses a locked account with its reason, then refuses when the member already has MAX_CONCURRENT_LOANS items out."
    },
    {
      "id": "ev-account-locked",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 16,
          "start": 8
        },
        "path": "circulation/eligibility.py",
        "symbol": "account_is_locked"
      },
      "summary": "An account is locked by any open loan that is overdue, and otherwise by owing more than LOCK_BALANCE_PENCE."
    },
    {
      "id": "ev-on-shelf",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 47,
          "start": 45
        },
        "path": "catalog/models.py",
        "symbol": "is_on_shelf"
      },
      "summary": "A copy is on the shelf exactly when it has no loan whose returned_at is still null."
    },
    {
      "id": "ev-due-date",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 13,
          "start": 8
        },
        "path": "catalog/utils.py",
        "symbol": "due_date_for"
      },
      "summary": "The due date is the borrow date plus the title's loan period, which is HIGH_DEMAND_LOAN_DAYS for a high-demand book and LOAN_DAYS otherwise."
    },
    {
      "id": "ev-lending-rules",
      "kind": "configuration",
      "locator": {
        "lineRange": {
          "end": 80,
          "start": 74
        },
        "path": "shelfmark/settings.py",
        "symbol": "LOAN_DAYS"
      },
      "summary": "The lending rules: LOAN_DAYS 21, HIGH_DEMAND_LOAN_DAYS 7, LOCK_BALANCE_PENCE 1000 and MAX_CONCURRENT_LOANS 10."
    },
    {
      "id": "ev-issue-test",
      "kind": "test",
      "locator": {
        "lineRange": {
          "end": 50,
          "start": 42
        },
        "path": "desk/tests.py",
        "symbol": "test_a_librarian_can_issue_a_copy"
      },
      "summary": "Posting the desk form as a signed-in librarian creates one Loan for the reader, due twenty-one days from today."
    },
    {
      "id": "ev-not-librarian-test",
      "kind": "test",
      "locator": {
        "lineRange": {
          "end": 57,
          "start": 52
        },
        "path": "desk/tests.py",
        "symbol": "test_a_member_cannot_reach_the_desk"
      },
      "summary": "A signed-in member who is not a librarian does not get a 200 from /desk/."
    },
    {
      "id": "ev-overdue-refused-test",
      "kind": "test",
      "locator": {
        "lineRange": {
          "end": 71,
          "start": 59
        },
        "path": "desk/tests.py",
        "symbol": "test_issuing_to_an_account_with_an_overdue_item_is_refused"
      },
      "summary": "Issuing to an account holding an overdue item comes back saying overdue, and no loan is created for the copy."
    },
    {
      "id": "ev-unknown-barcode-test",
      "kind": "test",
      "locator": {
        "lineRange": {
          "end": 103,
          "start": 98
        },
        "path": "desk/tests.py",
        "symbol": "test_an_unknown_barcode_is_rejected"
      },
      "summary": "An unknown barcode is answered with No copy with that barcode."
    }
  ],
