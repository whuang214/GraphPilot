{
  "schemaVersion": "graphpilot.draft.v1",
  "kind": "diagramDraft",
  "diagramName": "tickbox-move-a-card",
  "diagramType": "activity_diagram",
  "authority": "as_implemented",
  "requests": [
    "What happens when someone moves a card to another column."
  ],
  "evidence": [
    {
      "id": "ev-board-buttons",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 64,
          "start": 56
        },
        "path": "frontend/src/pages/Board.tsx",
        "symbol": "moveTask"
      },
      "summary": "Each card renders one button per other column, only when editable, and the click calls moveTask(task.id, column)."
    },
    {
      "id": "ev-can-edit",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 12,
          "start": 10
        },
        "path": "frontend/src/lib/can.ts",
        "symbol": "canEditTask"
      },
      "summary": "canEditTask is true only for an owner or an editor, and it is what hides the move buttons from a viewer."
    },
    {
      "id": "ev-move",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 43,
          "start": 27
        },
        "path": "frontend/src/store/board.ts",
        "symbol": "moveTask"
      },
      "summary": "moveTask keeps the current list as 'before', repaints the card in the new column immediately, PATCHes the task, swaps in the saved copy on success, and restores 'before' plus an error message on failure."
    },
    {
      "id": "ev-patch-task",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 86,
          "start": 80
        },
        "path": "frontend/src/api/client.ts",
        "symbol": "patchTask"
      },
      "summary": "patchTask sends PATCH /api/tasks/{id} with the patch body and passes the reply through adoptTask."
    },
    {
      "id": "ev-call-error",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 27,
          "start": 24
        },
        "path": "frontend/src/api/client.ts"
      },
      "summary": "Any non-2xx reply is turned into a thrown Error carrying the server's 'detail' text, or the status line if there is none."
    },
    {
      "id": "ev-adopt",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 37,
          "start": 32
        },
        "path": "frontend/src/api/client.ts",
        "symbol": "adoptTask"
      },
      "summary": "adoptTask renames the API's 'state' field to the client's 'status' on every task that crosses the boundary."
    },
    {
      "id": "ev-current-user",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 20,
          "start": 9
        },
        "path": "backend/app/deps.py",
        "symbol": "current_user"
      },
      "summary": "Every guarded route resolves the caller from the Authorization header first, 401ing on a missing, expired or unknown token."
    },
    {
      "id": "ev-workspace-of-task",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 59,
          "start": 53
        },
        "path": "backend/app/permissions.py",
        "symbol": "workspace_of_task"
      },
      "summary": "workspace_of_task joins the task to its project to find the workspace id, and raises 404 'No such task.' when that join finds nothing."
    },
    {
      "id": "ev-require-writer",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 36,
          "start": 9
        },
        "path": "backend/app/permissions.py",
        "symbol": "require_writer"
      },
      "summary": "require_member raises 404 when the caller has no membership; require_writer then raises 403 unless that role is in WRITERS, which is owner or editor."
    },
    {
      "id": "ev-update-task",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 79,
          "start": 57
        },
        "path": "backend/app/routers/tasks.py",
        "symbol": "update_task"
      },
      "summary": "PATCH /api/tasks/{id} requires a writer, loads the task, maps body['state'] onto Status (422 if unknown), stamps or clears completed_at, records an 'updated' activity event and commits."
    },
    {
      "id": "ev-task-out",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 19,
          "start": 7
        },
        "path": "backend/app/serialise.py",
        "symbol": "task_out"
      },
      "summary": "task_out returns the task with its status under the field name 'state', alongside completed_at, subtasks and labels."
    },
    {
      "id": "ev-board-error",
      "kind": "code",
      "locator": {
        "lineRange": {
          "end": 29,
          "start": 29
        },
        "path": "frontend/src/pages/Board.tsx"
      },
      "summary": "The board renders the store's error string above the columns when it is set."
    },
    {
      "id": "ev-stamp-tests",
      "kind": "test",
      "locator": {
        "lineRange": {
          "end": 246,
          "start": 222
        },
        "path": "backend/tests/test_api.py",
        "symbol": "test_moving_a_task_to_done_stamps_the_time"
      },
      "summary": "Two tests pin the timestamp behaviour: patching state to done fills completed_at, and patching it back to doing clears it."
    }
  ],
