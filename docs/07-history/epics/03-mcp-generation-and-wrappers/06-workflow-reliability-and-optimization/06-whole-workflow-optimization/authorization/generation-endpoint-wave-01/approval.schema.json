{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graphpilot.delivery.generation-endpoint-wave-approval.v1",
  "title": "GraphPilot Block 6 Generation Endpoint Wave Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "approvalId", "packageId", "anchorDigest", "decision", "reviewer", "reviewedAt", "sections", "attestations", "overallNotes", "digest"],
  "properties": {
    "schemaVersion": {"const": "graphpilot.delivery.generation-endpoint-wave-approval.v1"},
    "kind": {"const": "generationEndpointWaveApproval"},
    "approvalId": {"type": "string", "pattern": "^approval-live-anchor-b6-generation-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "packageId": {"const": "package-live-anchor-b6-generation-cold-room-20260729-01"},
    "anchorDigest": {"const": "sha256:e416aa726ef11e171b232c4c9032fd9df3e280e14bc39e2d78dacea918c29072"},
    "decision": {"enum": ["approve", "revise"]},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "attestation"],
      "properties": {
        "kind": {"const": "product_owner"},
        "id": {"type": "string", "pattern": "^product-owner-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
        "attestation": {"const": "I am the human product owner making this decision; no agent made it for me."}
      }
    },
    "reviewedAt": {"type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 32},
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "readiness", "requiredMeaning", "forbiddenMeaning", "delivery", "liveSchedule", "scope"],
      "properties": {
        "identity": {"$ref": "#/$defs/section"},
        "readiness": {"$ref": "#/$defs/section"},
        "requiredMeaning": {"$ref": "#/$defs/section"},
        "forbiddenMeaning": {"$ref": "#/$defs/section"},
        "delivery": {"$ref": "#/$defs/section"},
        "liveSchedule": {"$ref": "#/$defs/section"},
        "scope": {"$ref": "#/$defs/section"}
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanReview", "agentReviewExcluded", "notCalibrationOrCertification", "checklistExcludedFromProvider", "singleCandidateOnly", "aggregateBudgetAccepted", "s06CommitBound", "b0PathGateBound"],
      "properties": {
        "humanReview": {"type": "boolean"},
        "agentReviewExcluded": {"type": "boolean"},
        "notCalibrationOrCertification": {"type": "boolean"},
        "checklistExcludedFromProvider": {"type": "boolean"},
        "singleCandidateOnly": {"type": "boolean"},
        "aggregateBudgetAccepted": {"type": "boolean"},
        "s06CommitBound": {"type": "boolean"},
        "b0PathGateBound": {"type": "boolean"}
      }
    },
    "overallNotes": {"type": "string", "maxLength": 4000},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "notes"],
      "properties": {
        "decision": {"enum": ["approve", "revise"]},
        "notes": {"type": "string", "maxLength": 2000}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "approve"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "sections": {
            "properties": {
              "identity": {"properties": {"decision": {"const": "approve"}}},
              "readiness": {"properties": {"decision": {"const": "approve"}}},
              "requiredMeaning": {"properties": {"decision": {"const": "approve"}}},
              "forbiddenMeaning": {"properties": {"decision": {"const": "approve"}}},
              "delivery": {"properties": {"decision": {"const": "approve"}}},
              "liveSchedule": {"properties": {"decision": {"const": "approve"}}},
              "scope": {"properties": {"decision": {"const": "approve"}}}
            }
          },
          "attestations": {
            "properties": {
              "humanReview": {"const": true},
              "agentReviewExcluded": {"const": true},
              "notCalibrationOrCertification": {"const": true},
              "checklistExcludedFromProvider": {"const": true},
              "singleCandidateOnly": {"const": true},
              "aggregateBudgetAccepted": {"const": true},
              "s06CommitBound": {"const": true},
              "b0PathGateBound": {"const": true}
            }
          }
        }
      }
    }
  ]
}
