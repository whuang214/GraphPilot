    "sections": {"type": "object", "additionalProperties": false, "required": ["identity", "readiness", "requiredMeaning", "forbiddenMeaning", "delivery", "liveSchedule", "scope"], "properties": {"identity": {"$ref": "#/$defs/section"}, "readiness": {"$ref": "#/$defs/section"}, "requiredMeaning": {"$ref": "#/$defs/section"}, "forbiddenMeaning": {"$ref": "#/$defs/section"}, "delivery": {"$ref": "#/$defs/section"}, "liveSchedule": {"$ref": "#/$defs/section"}, "scope": {"$ref": "#/$defs/section"}}},
    "attestations": {"type": "object", "additionalProperties": false, "required": ["humanReview", "agentReviewExcluded", "notCalibrationOrCertification", "checklistExcludedFromProvider", "singleCandidateOnly", "aggregateBudgetAccepted", "s06CommitBound", "b0PathGateBound"], "properties": {"humanReview": {"const": true}, "agentReviewExcluded": {"const": true}, "notCalibrationOrCertification": {"const": true}, "checklistExcludedFromProvider": {"const": true}, "singleCandidateOnly": {"const": true}, "aggregateBudgetAccepted": {"const": true}, "s06CommitBound": {"const": true}, "b0PathGateBound": {"const": true}}},
